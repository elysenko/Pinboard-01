# --- Required (provisioned by the platform; the app refuses to boot without them) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
JWT_SECRET="change-me-in-production"

# --- Optional ---
PORT=3001
NODE_ENV=development
# Access-token lifetime, as an `ms` duration string.
JWT_EXPIRES_IN=1d
# Restricts CORS to a single origin. Unset means "reflect the request origin".
FRONTEND_URL=http://localhost:4200

# --- Optional third-party credentials ---
# Absent values never break startup: the feature returns 503 until configured,
# either here or through the admin settings screen (/api/admin/settings).
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
