{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "isolatedModules": true, "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}
