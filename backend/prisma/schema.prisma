// PinBoard — Prisma schema
// Datasource: PostgreSQL (DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A sticky note on the public wall.
/// Ordering is `createdAt DESC, id DESC`; the index below backs that read path.
model Pin {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(120)
  body      String   @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Application account. The public pin wall is readable without a User;
/// accounts exist for the authenticated /admin section.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

/// Runtime override layer for service credentials.
/// `resolveConfig()` reads process.env first and falls back to this table.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
