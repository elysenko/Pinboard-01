# Dependencies — regenerated by `npm ci` during the deploy build; never committed.
node_modules/

# Build output — regenerated by `npm run build` during the deploy build.
dist/
out-tsc/
/tmp/

# Angular build cache
.angular/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
*.swp

# Local environment files. The platform injects DATABASE_URL/JWT_SECRET as real env
# vars; a committed .env would be auto-loaded by the Prisma CLI and silently override
# them during `migrate deploy`. Templates (.env.example) stay tracked.
.env
.env.*
!.env.example

# Jest coverage output
coverage/
